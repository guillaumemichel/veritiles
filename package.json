{
  "name": "anymirror-repo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/router",
    "packages/anymirror",
    "packages/veritiles"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --conditions=anymirror-source --test 'test/!(pack-diff|packages).test.ts' && node --conditions=anymirror-source packages/veritiles/examples/build-assets.ts",
    "test:diff": "node --conditions=anymirror-source --test test/pack-diff.test.ts",
    "test:packages": "node --test test/packages.test.ts",
    "pack": "node --conditions=anymirror-source tools/pack.ts",
    "pack:rs": "cargo run --release -q --manifest-path packer/Cargo.toml --",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run build -w @anymirror/router && npm run build -w anymirror && npm run build -w veritiles",
    "version:line": "node tools/version.ts"
  },
  "devDependencies": {
    "@ipld/car": "^5.4.6",
    "@ipld/dag-cbor": "^10.0.2",
    "@ipld/dag-pb": "^4.1.7",
    "@types/node": "^26.1.1",
    "blockstore-core": "^7.0.1",
    "esbuild": "^0.28.1",
    "hash-wasm": "^4.12.0",
    "ipfs-unixfs": "^13.0.0",
    "ipfs-unixfs-importer": "^17.0.1",
    "multiformats": "^14.0.4",
    "pmtiles": "^4.4.1",
    "typescript": "^7.0.2"
  }
}
